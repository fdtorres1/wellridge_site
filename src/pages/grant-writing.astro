---
import BaseLayout from '../layouts/BaseLayout.astro';

const offerSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Bounded grant-writing support',
  provider: { '@type': 'Organization', name: 'Wellridge Group', url: 'https://wellridgegroup.com' },
  serviceType: 'Grant application review, letters of inquiry, and short foundation applications',
  offers: [
    { '@type': 'Offer', name: 'Existing application review', price: '295', priceCurrency: 'USD', url: 'https://wellridgegroup.com/grant-writing' },
    { '@type': 'Offer', name: 'Letter of inquiry', price: '350', priceCurrency: 'USD', url: 'https://wellridgegroup.com/grant-writing' },
    { '@type': 'Offer', name: 'Short foundation application', price: '750', priceCurrency: 'USD', url: 'https://wellridgegroup.com/grant-writing' },
  ],
};
---

<BaseLayout
  title="Grant Writing Services"
  description="Bounded review, letter-of-inquiry, and short foundation application support for organizations with an identified opportunity."
  structuredData={offerSchema}
>
  <section class="py-20 bg-gradient-to-b from-white to-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-wide text-ridge-blue">A defined starting point</p>
      <h1 class="text-5xl font-serif font-bold text-slate-deep mt-3 mb-6">Grant writing with a clear handoff</h1>
      <p class="text-xl text-gray-600">Short, reviewable scopes for an identified funder or application. We inspect the instructions first, align the narrative to the approved program and budget, and leave the organization with a submission-ready package it can approve and submit.</p>
      <a href="/contact?service=grant-writing" class="inline-block mt-8 px-8 py-3 bg-ridge-blue text-white rounded-md text-lg font-medium">Prepare an inquiry</a>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <article class="border border-gray-200 rounded-lg p-6">
          <p class="text-sm font-semibold text-ridge-blue">$295 · paid upfront</p>
          <h2 class="text-2xl font-serif font-bold text-slate-deep mt-2 mb-3">Existing application review</h2>
          <p class="text-gray-700">Review of a narrative up to 2,000 words against one funder rubric or instruction set, with tracked edits and a missing-items checklist.</p>
          <p class="text-sm text-gray-600 mt-4">First draft within 3 business days after complete materials and access.</p>
        </article>
        <article class="border border-gray-200 rounded-lg p-6">
          <p class="text-sm font-semibold text-ridge-blue">$350 · paid upfront</p>
          <h2 class="text-2xl font-serif font-bold text-slate-deep mt-2 mb-3">Letter of inquiry</h2>
          <p class="text-gray-700">A letter up to two pages for one identified funder, using an existing program and budget, with one revision.</p>
          <p class="text-sm text-gray-600 mt-4">First draft within 3 business days after complete materials and access.</p>
        </article>
        <article class="border border-gray-200 rounded-lg p-6">
          <p class="text-sm font-semibold text-ridge-blue">$750 · split milestone</p>
          <h2 class="text-2xl font-serif font-bold text-slate-deep mt-2 mb-3">Short foundation application</h2>
          <p class="text-gray-700">One identified opportunity, up to 2,000 narrative words, an attachment checklist, and one consolidated revision using an approved program and budget.</p>
          <p class="text-sm text-gray-600 mt-4">$375 to begin and $375 on delivery of the agreed submission-ready package; first draft within 5–7 business days after complete materials and access.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="py-16 bg-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-slate-deep mb-6">What stays with the client</h2>
      <ul class="list-disc pl-6 space-y-3 text-gray-700">
        <li>The client confirms facts, approves the final materials, and submits the application.</li>
        <li>There is no award guarantee, percentage fee, federal application, new program design, or complex budget creation.</li>
        <li>Work does not begin until instructions and scope fit are inspected and agreed.</li>
        <li>Late inputs move the working deadline. Once work begins, earned work is payable; any unused prepaid scope is handled in the written engagement terms.</li>
        <li>There is no automatic recurring commitment. Additional work requires a separately agreed quote.</li>
      </ul>
      <div class="mt-8 border border-ridge-blue rounded-lg p-6 bg-blue-50"><h2 class="text-2xl font-serif font-bold text-slate-deep mb-2">See the review in practice</h2><p class="text-gray-700 mb-4">The fictional Northside Arts Workshop example shows how a vague draft becomes a specific, budget-consistent narrative with unresolved inputs called out.</p><a class="inline-block px-5 py-3 bg-ridge-blue text-white rounded-md font-medium" href="/work-examples/grant-review">View the fictional grant review example</a></div>
      <p class="mt-8 text-gray-700">Use the <a class="text-ridge-blue underline" href="/resources/grant-application-checklist">grant application checklist</a> before preparing an inquiry.</p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-slate-deep mb-8">Questions organizations usually ask</h2>
      <div class="space-y-6">
        <div><h3 class="text-xl font-serif font-bold">Can you write to any funder?</h3><p class="text-gray-700 mt-2">The offer begins with one identified opportunity and its controlling instructions. Fit and access are checked before acceptance.</p></div>
        <div><h3 class="text-xl font-serif font-bold">Do you submit on our behalf?</h3><p class="text-gray-700 mt-2">No. The client owns final factual approval and submission authority.</p></div>
        <div><h3 class="text-xl font-serif font-bold">What if the scope grows?</h3><p class="text-gray-700 mt-2">Expansion, additional funders, new program design, or complex budget work receives a separate quote.</p></div>
      </div>
    </div>
  </section>
</BaseLayout>
