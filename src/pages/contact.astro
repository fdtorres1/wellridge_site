---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact" description="Prepare a short, non-sensitive inquiry for Wellridge Group grant-writing and program-operations support.">
  <section class="py-20 bg-gradient-to-b from-white to-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-5xl font-serif font-bold text-slate-deep mb-6">Contact Wellridge Group</h1>
      <p class="text-xl text-gray-600">Review prepared details, then choose Open email draft. You send from your mail app.</p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
        <!-- Inquiry composer -->
        <div>
          <h2 class="text-2xl font-serif font-bold mb-6">Prepare an inquiry</h2>
          <div class="bg-fog p-8 rounded-lg space-y-5">
            <p class="text-gray-700">Recipient: <a class="text-ridge-blue underline" href="mailto:hello@wellridgegroup.com">hello@wellridgegroup.com</a></p>
            <label class="block"><span class="block text-sm font-semibold mb-1">Service</span><select id="inquiry-service" class="w-full rounded-md border border-gray-300 bg-white p-3"><option value="grant">Grant writing</option><option value="operations">Proposal &amp; program operations</option></select></label>
            <label class="block"><span class="block text-sm font-semibold mb-1">Organization</span><input id="inquiry-org" class="w-full rounded-md border border-gray-300 bg-white p-3" autocomplete="organization" /></label>
            <label class="block"><span class="block text-sm font-semibold mb-1">Public website</span><input id="inquiry-site" type="url" class="w-full rounded-md border border-gray-300 bg-white p-3" placeholder="https://" /></label>
            <label class="block"><span id="inquiry-detail-label" class="block text-sm font-semibold mb-1">Funder, instructions, and deadline</span><textarea id="inquiry-detail" rows="4" class="w-full rounded-md border border-gray-300 bg-white p-3" placeholder="Name the identified funder or link to public instructions, plus the deadline if known."></textarea></label>
            <label class="block"><span class="block text-sm font-semibold mb-1">Prepared details preview</span><textarea id="inquiry-preview" rows="7" readonly class="w-full rounded-md border border-gray-300 bg-white p-3 text-sm text-gray-700"></textarea></label>
            <div class="flex flex-wrap items-center gap-3">
              <button id="copy-details" type="button" class="px-5 py-3 border border-ridge-blue text-ridge-blue rounded-md font-medium">Copy details</button>
              <a id="inquiry-link" href="mailto:hello@wellridgegroup.com" class="inline-block px-6 py-3 bg-ridge-blue text-white rounded-md font-medium">Open email draft</a>
            </div>
            <p id="copy-status" class="text-sm text-gray-600" role="status" aria-live="polite">Review the preview, then copy it or open an email draft. Opening the draft does not send it.</p>
            <p id="inquiry-note" class="text-sm text-gray-600">Recipient: <a class="text-ridge-blue underline" href="mailto:hello@wellridgegroup.com">hello@wellridgegroup.com</a>. Keep confidential, personal, health, procurement-sensitive, and grant attachments out of the initial inquiry.</p>
          </div>
        </div>

        <!-- Scope Preparation -->
        <div>
          <h2 class="text-2xl font-serif font-bold mb-6">Prepare for a Scope Conversation</h2>
          <p class="text-gray-700 mb-4">For a first message, it helps to have:</p>
          <ul class="list-disc pl-5 space-y-2 text-gray-700">
            <li>Your organization and buyer type.</li>
            <li>The funding opportunity or program need.</li>
            <li>A deadline, decision date, or target launch window.</li>
            <li>The specific deliverables you need owned.</li>
            <li>Available source documents and a named decision-maker.</li>
            <li>Any clinical, technical, legal, data, or security boundaries.</li>
          </ul>

          <!-- Mini FAQ -->
          <div class="mt-12">
            <h2 class="text-2xl font-serif font-bold mb-6">Quick Questions</h2>
            <div class="space-y-4">
              <div>
                <h3 class="font-semibold text-slate-deep mb-1">What work does Wellridge support?</h3>
                <p class="text-sm text-gray-700">
                  Bounded grant-writing scopes and Proposal &amp; Program Operations Support for nonprofits, established public-sector contractors, and selected agencies.
                </p>
              </div>
              <div>
                <h3 class="font-semibold text-slate-deep mb-1">Does Wellridge guarantee funding or awards?</h3>
                <p class="text-sm text-gray-700">
                  No. Opportunity qualification and proposal discipline can improve decision quality, but award decisions remain with the funder or contracting authority.
                </p>
              </div>
              <div>
                <h3 class="font-semibold text-slate-deep mb-1">Does Wellridge provide clinical or technical services?</h3>
                <p class="text-sm text-gray-700">
                  No. Wellridge may own nonclinical administration, coordination, engagement, compliance, reporting, and closeout; clinical care, engineering, and other specialized judgment stay with appropriately qualified professionals.
                </p>
              </div>
              <div>
                <h3 class="font-semibold text-slate-deep mb-1">How is work scoped?</h3>
                <p class="text-sm text-gray-700">
                  Work is defined in a fixed-scope or milestone-based statement of work with named deliverables, inputs, approvals, and change control. Compensation is not based on a percentage of an award.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const service = document.querySelector<HTMLSelectElement>('#inquiry-service');
  const org = document.querySelector<HTMLInputElement>('#inquiry-org');
  const site = document.querySelector<HTMLInputElement>('#inquiry-site');
  const detail = document.querySelector<HTMLTextAreaElement>('#inquiry-detail');
  const detailLabel = document.querySelector<HTMLSpanElement>('#inquiry-detail-label');
  const preview = document.querySelector<HTMLTextAreaElement>('#inquiry-preview');
  const copyButton = document.querySelector<HTMLButtonElement>('#copy-details');
  const copyStatus = document.querySelector<HTMLParagraphElement>('#copy-status');
  const link = document.querySelector<HTMLAnchorElement>('#inquiry-link');
  const requestedService = new URLSearchParams(window.location.search).get('service');
  if (service && requestedService === 'operations') service.value = 'operations';
  if (service && requestedService === 'grant-writing') service.value = 'grant';
  const updateInquiry = () => {
    const isGrant = service?.value === 'grant';
    const detailHeading = isGrant ? 'Funder, instructions, and deadline' : 'Operations scope, deliverables, and deadline';
    const detailPlaceholder = isGrant ? 'Name the identified funder or link to public instructions, plus the deadline if known.' : 'Describe the work package, deliverables or records involved, and the deadline or target launch window.';
    if (detailLabel) detailLabel.textContent = detailHeading;
    if (detail) detail.placeholder = detailPlaceholder;
    const subject = isGrant ? 'Wellridge grant-writing inquiry' : 'Wellridge program-operations inquiry';
    const body = `Organization: ${org?.value || ''}\nPublic website: ${site?.value || ''}\n${detailHeading}: ${detail?.value || ''}\n\nI have not attached sensitive documents. I would like to confirm fit and scope before payment.`;
    if (preview) preview.value = body;
    if (link) link.href = `mailto:hello@wellridgegroup.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  };
  [service, org, site, detail].forEach((field) => field?.addEventListener('input', updateInquiry));
  service?.addEventListener('change', updateInquiry);
  copyButton?.addEventListener('click', async () => {
    const text = preview?.value || '';
    try {
      await navigator.clipboard.writeText(text);
      if (copyStatus) copyStatus.textContent = 'Details copied. Paste them into your mail app or another review document.';
    } catch {
      preview?.focus();
      preview?.select();
      if (copyStatus) copyStatus.textContent = 'Select the prepared details above and copy them with your device shortcut.';
    }
  });
  updateInquiry();
</script>
