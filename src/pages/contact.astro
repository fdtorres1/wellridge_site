---
import BaseLayout from '../layouts/BaseLayout.astro';
import { grantOffers } from '../lib/grants';
const inputClass = 'w-full rounded-md border border-gray-300 bg-white p-3 focus:outline-none focus:ring-2 focus:ring-ridge-blue';
---
<BaseLayout title="Contact" description="Send an inquiry about Wellridge Group grant review, letters of inquiry, foundation applications, or program operations.">
  <section class="py-16 bg-gradient-to-b from-white to-fog"><div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="text-4xl sm:text-5xl font-serif font-bold text-slate-deep mb-5">Tell us what you need help with</h1>
    <p class="text-xl text-gray-600">Share the opportunity, deadline, and work you need. We’ll check fit and confirm a written scope before payment.</p>
  </div></section>
  <section class="py-16 bg-white"><div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid md:grid-cols-2 gap-12">
    <div id="inquiry">
      <h2 class="text-2xl font-serif font-bold mb-6">Send an inquiry</h2>
      <form id="inquiry-form" method="post" class="bg-fog p-6 sm:p-8 rounded-lg space-y-5">
        <fieldset id="inquiry-fields" disabled class="space-y-5 disabled:opacity-70">
          <legend class="sr-only">Your service inquiry</legend>
          <label class="block"><span class="block text-sm font-semibold mb-1">Your name (required)</span><input name="name" required maxlength="150" autocomplete="name" class={inputClass} /></label>
          <label class="block"><span class="block text-sm font-semibold mb-1">Reply email (required)</span><input name="email" type="email" required maxlength="254" autocomplete="email" class={inputClass} /></label>
          <label class="block"><span class="block text-sm font-semibold mb-1">Organization (required)</span><input name="organization" required maxlength="200" autocomplete="organization" class={inputClass} /></label>
          <label class="block"><span class="block text-sm font-semibold mb-1">Service</span><select name="service" id="inquiry-service" class={inputClass}><option value="grant-writing">Grant writing</option><option value="operations">Proposal &amp; program operations</option></select></label>
          <label id="package-field" class="block"><span class="block text-sm font-semibold mb-1">Grant package</span><select name="package" id="inquiry-package" class={inputClass}><option value="unsure">Help me choose</option>{grantOffers.map(offer => <option value={offer.id}>{offer.name} — {offer.price}</option>)}</select></label>
          <label class="block"><span class="block text-sm font-semibold mb-1">Public website (optional)</span><input name="website" inputmode="url" maxlength="300" autocomplete="url" class={inputClass} /></label>
          <label class="block"><span class="block text-sm font-semibold mb-1">Deadline or target date (optional)</span><input name="deadline" maxlength="200" placeholder="Include the time zone if there is a deadline" class={inputClass} /></label>
          <label class="block"><span id="detail-label" class="block text-sm font-semibold mb-1">Funder, public instructions, and help needed (required)</span><textarea name="message" rows="5" required maxlength="3000" class={inputClass}></textarea></label>
          <div class="hidden" aria-hidden="true"><label>Leave empty<input name="_honey" tabindex="-1" autocomplete="off" /></label></div>
        </fieldset>
        <button id="send-inquiry" type="submit" class="hidden rounded-md bg-ridge-blue px-6 py-3 font-medium text-white disabled:opacity-60">Send inquiry</button>
        <p class="text-sm text-gray-600">Sending shares these details with Wellridge through FormSubmit so we can respond. Use public information only; leave out attachments, passwords, personal or health records, and procurement-sensitive information. <a href="/privacy" class="text-ridge-blue underline">Privacy details</a>.</p>
        <noscript><p>Email <a class="text-ridge-blue underline" href="mailto:hello@wellridgegroup.com">hello@wellridgegroup.com</a> to inquire. The send button requires JavaScript.</p></noscript>
      </form>
      <p id="inquiry-status" role="status" aria-live="polite" tabindex="-1" class="hidden mt-5 rounded-md border border-ridge-blue p-4 text-slate-deep"></p>
      <button id="new-inquiry" type="button" class="hidden mt-4 font-medium text-ridge-blue underline">Write another inquiry</button>
      <details id="email-fallback" class="mt-6 rounded-md border border-gray-200 p-5">
        <summary class="cursor-pointer font-medium text-ridge-blue">Prefer email or having trouble sending?</summary>
        <p class="mt-4 text-gray-600">Email <a class="text-ridge-blue underline" href="mailto:hello@wellridgegroup.com">hello@wellridgegroup.com</a>, or prepare your entered details below.</p>
        <button id="prepare-email" type="button" class="mt-4 rounded-md border border-ridge-blue px-4 py-2 text-ridge-blue">Prepare email instead</button>
        <div id="email-preview" class="hidden mt-4">
          <label class="block"><span class="block text-sm font-semibold mb-1">Prepared details</span><textarea id="prepared-details" rows="9" readonly class={inputClass}></textarea></label>
          <div class="mt-4 flex flex-wrap gap-3"><button id="copy-details" type="button" class="rounded-md border border-ridge-blue px-4 py-2 text-ridge-blue">Copy details</button><a id="open-email" class="rounded-md bg-ridge-blue px-4 py-2 text-white" href="mailto:hello@wellridgegroup.com">Open email draft</a></div>
        </div><p id="fallback-status" role="status" class="mt-3 text-sm text-gray-600"></p>
      </details>
    </div>
    <aside>
      <h2 class="text-2xl font-serif font-bold mb-5">A clear next step</h2>
      <ol class="list-decimal pl-5 space-y-4 text-gray-700"><li>Tell us your organization, the work you need, and any deadline.</li><li>We inspect the public instructions and confirm fit, required inputs, deliverables, and fee in writing.</li><li>After scope agreement and the initial payment, we start when the complete materials and access are ready.</li></ol>
      <p class="mt-6 text-gray-700">For grant work, the client confirms facts, approves the final package, and submits it. An inquiry does not reserve capacity or create an engagement. Wellridge does not guarantee funding.</p>
      <div class="mt-8 border-t border-gray-200 pt-6"><h2 class="text-2xl font-serif font-bold mb-4">Choose your starting point</h2><ul class="space-y-3">{grantOffers.map(offer => <li><a href={`/contact?service=grant-writing&package=${offer.id}#inquiry`} class="text-ridge-blue underline">{offer.name} — {offer.price}</a></li>)}</ul><p class="mt-5"><a href="/resources/grant-review-loi-or-application" class="text-ridge-blue underline">Compare the three grant options →</a></p></div>
      <p class="mt-8 text-gray-700">Proposal and program operations are quoted separately. Describe the deliverables and deadline; specialist judgment and final approvals stay with the appropriate client or professional.</p>
    </aside>
  </div></section>
</BaseLayout>
<script>import '../lib/contact';</script>
