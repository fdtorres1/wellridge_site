---
import BaseLayout from '../layouts/BaseLayout.astro';
import { grantOffers, grantOfferById } from '../lib/grants';
---

<BaseLayout title="Grant Writing Costs & Engagement Pricing" description={`Wellridge grant review costs ${grantOfferById.review.price}, an LOI ${grantOfferById.loi.price}, and a short application ${grantOfferById.application.price}. Compare scope, payment timing, and custom quotes.`}>
  <section class="py-20 bg-gradient-to-b from-white to-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-serif font-bold text-slate-deep mb-6">Grant Writing Costs &amp; Engagement Pricing</h1>
      <p class="text-xl text-gray-600">
        Clear scope, clear ownership, and a written fee before work begins.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-lg text-gray-700 mb-8">
        Requirements, timelines, inputs, and risk differ from one engagement to the next. After a fit and scope review, Wellridge provides a written fixed-fee proposal or milestone schedule tied to defined deliverables, responsibilities, and acceptance criteria.
      </p>
    </div>
  </section>

  <section class="py-16 bg-white border-t border-gray-100">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wide text-ridge-blue">Published entry scopes</p>
          <h2 class="text-3xl font-serif font-bold text-slate-deep mt-2">Grant writing</h2>
        </div>
        <a href="/grant-writing" class="text-ridge-blue underline font-medium">See full grant-writing scope →</a>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {grantOffers.map((offer) => (
          <article class="border border-gray-200 rounded-lg p-6">
            <p class="text-2xl font-bold text-ridge-blue">{offer.price}</p>
            <h3 class="text-xl font-serif font-bold text-slate-deep mt-2">{offer.name}</h3>
            <p class="text-gray-700 mt-3">{offer.description}</p>
            <p class="text-sm text-gray-600 mt-4">{offer.payment}; {offer.timing.toLowerCase()}</p>
            {offer.servicePath && <p class="mt-4"><a class="text-ridge-blue underline" href={offer.servicePath}>Explore {offer.shortName.toLowerCase()}</a></p>}
            <a class="inline-block mt-4 text-ridge-blue underline" href={`/contact?service=grant-writing&package=${offer.id}`}>Discuss this scope</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="grant-pricing-questions" class="py-16 bg-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-slate-deep mb-8">Before you choose a grant package</h2>
      <div class="space-y-6">
        <div class="bg-white rounded-lg p-6"><h3 class="text-xl font-serif font-bold mb-3">How much does grant writing cost at Wellridge?</h3><p class="text-gray-700">An existing application review is {grantOfferById.review.price}, a letter of inquiry is {grantOfferById.loi.price}, and a short foundation application is {grantOfferById.application.price}. These are fixed fees for the defined work above. We confirm that your instructions and materials fit before accepting the engagement; broader work receives a separate written quote.</p></div>
        <div class="bg-white rounded-lg p-6"><h3 class="text-xl font-serif font-bold mb-3">When do I pay?</h3><p class="text-gray-700">The {grantOfferById.review.price} review and {grantOfferById.loi.price} LOI are paid upfront after scope agreement. The {grantOfferById.application.price} application is {grantOfferById.application.payment}. Payment is for the agreed professional work and is not contingent on a grant award. An inquiry itself does not require payment or reserve capacity.</p></div>
        <div class="bg-white rounded-lg p-6"><h3 class="text-xl font-serif font-bold mb-3">When does the turnaround begin?</h3><p class="text-gray-700">After scope agreement, initial payment, and complete materials and access. Review and LOI first drafts are due within three business days; the short application first draft is due within five to seven. Those are first-draft timelines, so allow additional time for your factual review, included revisions, approvals, and submission.</p></div>
        <div class="bg-white rounded-lg p-6"><h3 class="text-xl font-serif font-bold mb-3">What if our materials are not ready?</h3><p class="text-gray-700">Tell us what is missing in the inquiry. We identify the inputs needed before starting; the delivery clock does not begin while required materials or access are missing. Late inputs move the working deadline. We do not fill gaps with invented facts. If work has already begun, earned work remains payable and the written engagement terms govern any unused prepaid scope.</p></div>
        <div class="bg-white rounded-lg p-6"><h3 class="text-xl font-serif font-bold mb-3">What changes the scope or requires a custom quote?</h3><p class="text-gray-700">A second funder, a narrative over 2,000 words, an LOI over two pages, additional revisions, extensive portal work, or a changed program can exceed the entry scope. Federal applications, new program design, and complex budgets are outside these packages and need a separate fit decision. A larger assignment is not automatically accepted: we agree on any feasible added work and fee before proceeding.</p></div>
        <div class="bg-white rounded-lg p-6"><h3 class="text-xl font-serif font-bold mb-3">Which revisions are included, and who submits?</h3><p class="text-gray-700">The LOI includes one revision; the short application includes one consolidated revision. The review includes one narrative review with tracked edits and a missing-items checklist. Further review rounds require agreement. Your organization verifies the facts, approves the final materials, and submits to the funder. No package guarantees an invitation or award.</p></div>
      </div>
      <p class="mt-8 text-gray-700">Still choosing? Read the <a href="/resources/grant-review-loi-or-application" class="text-ridge-blue underline">review, LOI, and application guide</a>, then <a href="/contact?service=grant-writing" class="text-ridge-blue underline">describe your opportunity</a>. Public instructions and a short summary are enough for the initial inquiry; agree separately on sharing working documents.</p>
    </div>
  </section>

  <!-- Offer Toggle -->
  <section class="py-8 bg-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col sm:flex-row justify-center gap-4" role="tablist" aria-label="Select an engagement type">
        <button
          id="tab-nonprofit"
          class="w-full sm:w-auto px-6 py-3 bg-ridge-blue text-white rounded-md font-medium transition-colors"
          role="tab"
          tabindex="0"
          aria-selected="true"
          aria-controls="panel-nonprofit"
        >
          Funding Pipeline Sprint
        </button>
        <button
          id="tab-operations"
          class="w-full sm:w-auto px-6 py-3 bg-gray-300 text-slate-deep rounded-md font-medium hover:bg-gray-400 transition-colors"
          role="tab"
          tabindex="-1"
          aria-selected="false"
          aria-controls="panel-operations"
        >
          Proposal & Program Operations
        </button>
      </div>
    </div>
  </section>

  <!-- Funding Pipeline Sprint (default visible) -->
  <section id="panel-nonprofit" class="py-16 bg-white" role="tabpanel" aria-labelledby="tab-nonprofit">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="border border-gray-200 rounded-lg p-8">
        <span class="text-sm font-semibold text-ridge-blue">Offer 1</span>
        <h2 class="text-2xl font-serif font-bold mb-4">Nonprofit Funding Pipeline Sprint</h2>
        <p class="text-3xl font-bold text-ridge-blue mb-6">Custom fixed fee</p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Qualified funder research with fit and exclusion analysis</li>
          <li>Priority ranking, evidence gaps, and recommended next actions</li>
          <li>A practical pursuit calendar for the agreed planning horizon</li>
          <li>One defined review and revision cycle</li>
        </ul>
      </div>

      <div class="border border-gray-200 rounded-lg p-8">
        <h2 class="text-2xl font-serif font-bold mb-4">Scope Set Before Kickoff</h2>
        <p class="text-3xl font-bold text-ridge-blue mb-6">Bounded research engagement</p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Defined geography, program family, funder types, and exclusions</li>
          <li>Defined list size, source depth, and calendar horizon</li>
          <li>Verified organizational facts and named internal decision-makers</li>
          <li>A dated opportunity screen—not a guarantee of funding</li>
        </ul>
      </div>

      <div class="border border-gray-200 rounded-lg p-8">
        <h2 class="text-2xl font-serif font-bold mb-4">Expansion by Separate Scope</h2>
        <p class="text-3xl font-bold text-ridge-blue mb-6">Only when useful</p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Selected proposal development or compliance support</li>
          <li>Award setup and reporting calendars</li>
          <li>Bounded quarterly funding-operations tasks</li>
          <li>No unlimited proposals, revisions, or ongoing calendar management</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Proposal & Program Operations (hidden by default) -->
  <section id="panel-operations" class="py-16 bg-white hidden" role="tabpanel" aria-labelledby="tab-operations">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      <div class="border border-gray-200 rounded-lg p-8">
        <span class="text-sm font-semibold text-ridge-blue">Offer 2</span>
        <h2 class="text-2xl font-serif font-bold mb-4">Proposal Operations Module</h2>
        <p class="text-3xl font-bold text-ridge-blue mb-6">Fixed fee or milestone schedule</p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Solicitation analysis and documented go/no-go support</li>
          <li>Compliance matrix, proposal calendar, and input coordination</li>
          <li>Narrative or workplan development and budget-to-scope alignment</li>
          <li>Production review, final QA, and submission support as scoped</li>
        </ul>
      </div>

      <div class="border border-gray-200 rounded-lg p-8">
        <h2 class="text-2xl font-serif font-bold mb-4">Program Launch & Compliance Module</h2>
        <p class="text-3xl font-bold text-ridge-blue mb-6">Milestone-based scope</p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Implementation, governance, roles, and escalation planning</li>
          <li>Compliance, deliverable, spend, and reporting calendars</li>
          <li>Stakeholder, partner, vendor, and records coordination systems</li>
          <li>Closeout structure and accountability handoff</li>
        </ul>
      </div>

      <div class="border border-gray-200 rounded-lg p-8">
        <h2 class="text-2xl font-serif font-bold mb-4">Responsibilities Stay Explicit</h2>
        <p class="text-3xl font-bold text-ridge-blue mb-6">No hidden ownership</p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Writing, production, implementation, and ongoing operations are scoped separately</li>
          <li>Client and partner inputs, approvals, meetings, travel, and data access are documented</li>
          <li>Clinical and technical judgments remain with qualified professionals</li>
          <li>Final client approval is required for external submissions and AI-assisted work</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Pricing Principles -->
  <section class="py-16 bg-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-8">Pricing Principles</h2>
      <div class="bg-white rounded-lg overflow-hidden">
        <table class="w-full">
          <thead class="bg-gray-100">
            <tr>
              <th class="px-6 py-3 text-left text-sm font-semibold text-slate-deep">Principle</th>
              <th class="px-6 py-3 text-left text-sm font-semibold text-slate-deep">How It Works</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200">
            <tr>
              <td class="px-6 py-4 text-gray-700">Fixed-fee scope</td>
              <td class="px-6 py-4 text-gray-700">Defined deliverables, assumptions, inputs, revisions, and acceptance</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-gray-700">Milestone billing</td>
              <td class="px-6 py-4 text-gray-700">Payments tied to agreed delivery or acceptance points</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-gray-700">Bounded recurring work</td>
              <td class="px-6 py-4 text-gray-700">Specific quarterly or 90-day tasks—not an unlimited outsourced department</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-gray-700">Change control</td>
              <td class="px-6 py-4 text-gray-700">New requirements are approved through an amended or separate scope</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-gray-700">Vendor and pass-through costs</td>
              <td class="px-6 py-4 text-gray-700">Committed only with clear terms and appropriate payment protection</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-gray-700">Ethical compensation</td>
              <td class="px-6 py-4 text-gray-700">No percentage-of-award grant fees or prohibited contingent fees</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- How We Work -->
  <section class="py-16 bg-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-6">How a Quote Is Built</h2>
      <div class="bg-fog p-8 rounded-lg">
        <h3 class="text-xl font-serif font-bold mb-4">Fit Review & Written Scope</h3>
        <p class="text-lg text-gray-700 mb-4">
          We first confirm the work is a responsible fit. The written proposal then reflects the labor, coordination, quality review, outside delivery costs, timeline, risk, and working-capital needs required by the scope.
        </p>
        <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
          <li>Responsibilities and specialist boundaries stated in writing</li>
          <li>Client inputs, decisions, and approval points documented</li>
          <li>Rush work, travel, or material vendor costs addressed before commitment</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- FAQs -->
  <section class="py-16 bg-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-8">Frequently Asked Questions</h2>
      <div class="space-y-6">
        <div class="bg-white p-6 rounded-lg">
          <h3 class="text-lg font-semibold mb-2">Why are other operations engagements custom quoted?</h3>
          <p class="text-gray-700">
            The funding pipeline, proposal, and program-operations scopes vary in responsibility, complexity, timeline, inputs, review burden, and outside costs. Those engagements are custom quoted after scope review; the three grant-writing entry scopes above have published fixed fees for their defined work.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg">
          <h3 class="text-lg font-semibold mb-2">Do you work on tight deadlines?</h3>
          <p class="text-gray-700">
            Only when capacity, inputs, review time, and delivery risk support responsible work. Any rush conditions and their effect on scope, staffing, or milestones are agreed before kickoff.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg">
          <h3 class="text-lg font-semibold mb-2">Do you offer monthly retainers?</h3>
          <p class="text-gray-700">
            Recurring support may use a 90-day or master agreement with clearly bounded task orders. We do not offer unlimited proposals, unlimited revisions, or an employee-like outsourced department under an open-ended retainer.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg">
          <h3 class="text-lg font-semibold mb-2">Will you work without internal inputs?</h3>
          <p class="text-gray-700">
            No. Reliable research, proposals, and operating plans require verified organizational facts, subject-matter input, timely decisions, and final client approval.
          </p>
        </div>
        <div class="bg-white p-6 rounded-lg">
          <h3 class="text-lg font-semibold mb-2">Can you support post-award work?</h3>
          <p class="text-gray-700">
            Yes, when the administrative and program-operations responsibilities are a fit and can be clearly scoped. Clinical, legal, engineering, cybersecurity, accounting, and other specialist work remains with appropriately qualified professionals.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-slate-deep text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-serif font-bold mb-6">Prepare the Scope</h2>
      <p class="text-xl text-gray-300 mb-8">
        Share the opportunity, deadline, current inputs, and work you need. We’ll confirm fit and a written scope before payment.
      </p>
      <a
        href="/contact"
        class="inline-block px-8 py-3 bg-ridge-blue text-white rounded-md text-lg font-medium hover:bg-opacity-90 transition-colors"
      >
        Send an inquiry
      </a>
    </div>
  </section>
</BaseLayout>

<script>
  const nonprofitTab = document.getElementById('tab-nonprofit');
  const operationsTab = document.getElementById('tab-operations');
  const nonprofitPanel = document.getElementById('panel-nonprofit');
  const operationsPanel = document.getElementById('panel-operations');

  function switchTab(activeTab: 'nonprofit' | 'operations', moveFocus = false) {
    if (activeTab === 'nonprofit') {
      nonprofitTab?.setAttribute('aria-selected', 'true');
      nonprofitTab?.setAttribute('tabindex', '0');
      nonprofitTab?.classList.remove('bg-gray-300', 'text-slate-deep');
      nonprofitTab?.classList.add('bg-ridge-blue', 'text-white');
      operationsTab?.setAttribute('aria-selected', 'false');
      operationsTab?.setAttribute('tabindex', '-1');
      operationsTab?.classList.remove('bg-ridge-blue', 'text-white');
      operationsTab?.classList.add('bg-gray-300', 'text-slate-deep');
      nonprofitPanel?.classList.remove('hidden');
      operationsPanel?.classList.add('hidden');
      if (moveFocus) nonprofitTab?.focus();
    } else {
      operationsTab?.setAttribute('aria-selected', 'true');
      operationsTab?.setAttribute('tabindex', '0');
      operationsTab?.classList.remove('bg-gray-300', 'text-slate-deep');
      operationsTab?.classList.add('bg-ridge-blue', 'text-white');
      nonprofitTab?.setAttribute('aria-selected', 'false');
      nonprofitTab?.setAttribute('tabindex', '-1');
      nonprofitTab?.classList.remove('bg-ridge-blue', 'text-white');
      nonprofitTab?.classList.add('bg-gray-300', 'text-slate-deep');
      operationsPanel?.classList.remove('hidden');
      nonprofitPanel?.classList.add('hidden');
      if (moveFocus) operationsTab?.focus();
    }
  }

  nonprofitTab?.addEventListener('click', () => switchTab('nonprofit'));
  operationsTab?.addEventListener('click', () => switchTab('operations'));

  [nonprofitTab, operationsTab].forEach((tab, index) => {
    tab?.addEventListener('keydown', (event) => {
      if (!(event instanceof KeyboardEvent)) return;

      let nextIndex = index;
      if (event.key === 'ArrowRight' || event.key === 'ArrowDown') nextIndex = (index + 1) % 2;
      else if (event.key === 'ArrowLeft' || event.key === 'ArrowUp') nextIndex = (index + 1) % 2;
      else if (event.key === 'Home') nextIndex = 0;
      else if (event.key === 'End') nextIndex = 1;
      else return;

      event.preventDefault();
      switchTab(nextIndex === 0 ? 'nonprofit' : 'operations', true);
    });
  });
</script>
