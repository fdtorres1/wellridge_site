---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Funding & Program Operations">
  <!-- Hero Section -->
  <section class="bg-gradient-to-b from-white to-fog py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h1 class="text-5xl md:text-6xl font-serif font-bold text-slate-deep mb-6">
        Funding &amp; Program Operations
      </h1>
      <p class="text-xl text-gray-600 mb-8">
        Wellridge Group helps nonprofits and public-sector organizations qualify funding opportunities, develop compliant proposals, and put the operating systems in place to launch and manage funded programs.
      </p>
      <a
        href="/contact?service=grant-writing"
        class="inline-block px-8 py-3 bg-ridge-blue text-white rounded-md text-lg font-medium hover:bg-opacity-90 transition-colors"
      >
        Discuss your grant
      </a>
    </div>
  </section>

  <!-- At-a-Glance -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="text-center">
          <div class="w-16 h-16 bg-ridge-blue rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
          </div>
          <h3 class="text-xl font-serif font-bold mb-2">Qualify</h3>
          <p class="text-gray-600">Opportunity research, fit analysis, and go/no-go decisions that focus effort before proposal work begins.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-well-green rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
            </svg>
          </div>
          <h3 class="text-xl font-serif font-bold mb-2">Develop</h3>
          <p class="text-gray-600">Compliance matrices, workplans, narratives, budgets, calendars, and production QA for a defined pursuit.</p>
        </div>
        <div class="text-center">
          <div class="w-16 h-16 bg-slate-deep rounded-full flex items-center justify-center mx-auto mb-4">
            <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-xl font-serif font-bold mb-2">Operate</h3>
          <p class="text-gray-600">Implementation planning, coordination, reporting, records, and closeout for a bounded program scope.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Services -->
  <section class="py-16 bg-fog">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-center mb-12">How We Help</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-serif font-bold mb-3">Nonprofit Funding Pipeline Sprint</h3>
          <p class="text-gray-600 mb-4">A defined research sprint that produces a qualified, prioritized pursuit plan and identifies fit, risk, next actions, and evidence gaps before proposal spend.</p>
          <a href="/services" class="text-ridge-blue hover:underline font-medium">Learn more →</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-serif font-bold mb-3">Proposal &amp; Program Operations Support</h3>
          <p class="text-gray-600 mb-4">A bounded work package for proposal compliance and production, program launch, coordination, reporting, records, or closeout—with ownership defined in the statement of work.</p>
          <a href="/services" class="text-ridge-blue hover:underline font-medium">Learn more →</a>
        </div>
        <div class="bg-white p-6 rounded-lg shadow-sm">
          <h3 class="text-xl font-serif font-bold mb-3">Grant Writing Services</h3>
          <p class="text-gray-600 mb-4">One-time grant review, letter-of-inquiry, and short foundation application writing for nonprofits nationwide, with fixed fees and no retainer required.</p>
          <a href="/grant-writing" class="text-ridge-blue hover:underline font-medium">Compare grant services and prices →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Process Snapshot -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold text-center mb-12">From Opportunity to Operations</h2>
      <div class="grid grid-cols-2 md:grid-cols-6 gap-4">
        <div class="text-center">
          <div class="w-12 h-12 bg-ridge-blue text-white rounded-full flex items-center justify-center mx-auto mb-2 font-bold">1</div>
          <p class="text-sm font-medium">Qualify</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-ridge-blue text-white rounded-full flex items-center justify-center mx-auto mb-2 font-bold">2</div>
          <p class="text-sm font-medium">Decide</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-ridge-blue text-white rounded-full flex items-center justify-center mx-auto mb-2 font-bold">3</div>
          <p class="text-sm font-medium">Scope</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-ridge-blue text-white rounded-full flex items-center justify-center mx-auto mb-2 font-bold">4</div>
          <p class="text-sm font-medium">Launch &amp; Control</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-ridge-blue text-white rounded-full flex items-center justify-center mx-auto mb-2 font-bold">5</div>
          <p class="text-sm font-medium">Review &amp; Deliver</p>
        </div>
        <div class="text-center">
          <div class="w-12 h-12 bg-ridge-blue text-white rounded-full flex items-center justify-center mx-auto mb-2 font-bold">6</div>
          <p class="text-sm font-medium">Close &amp; Extend</p>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/process" class="text-ridge-blue hover:underline font-medium">See how engagements work →</a>
      </div>
    </div>
  </section>

  <!-- About Preview -->
  <section class="py-16 bg-fog">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="bg-white p-8 rounded-lg shadow-sm">
        <h2 class="text-3xl font-serif font-bold mb-4">Bounded Scope, Clear Ownership</h2>
        <p class="text-gray-600 mb-6">
          Wellridge Group starts with fit and scope. For nonprofits, that may mean a qualified funding pipeline or a compliant proposal. For established public-sector contractors and selected agencies, it may mean a defined proposal, launch, coordination, reporting, or closeout work package.
        </p>
        <p class="text-gray-600 mb-6">
          Every engagement separates the work Wellridge owns from client decisions and specialist responsibilities. Clinical, legal, engineering, cybersecurity, accounting, and other technical judgment remain with appropriately qualified professionals.
        </p>
        <a href="/about" class="inline-block text-ridge-blue hover:underline font-medium">Learn more about our approach →</a>
      </div>
    </div>
  </section>

  <!-- Latest Insights -->
  <section class="py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl font-serif font-bold mb-12">Latest Insights</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-sm text-gray-500 font-medium">Strategy &amp; Fit · Working Heuristic</span>
          <h3 class="text-xl font-serif font-bold mt-2 mb-2">A 7-Minute Go/No-Go Check</h3>
          <p class="text-gray-600 text-sm mb-4">A practitioner-created screen for assessing fit before committing more time to research and review.</p>
          <a href="/insights/7-minute-go-no-go" class="text-ridge-blue hover:underline font-medium text-sm">Read more →</a>
        </div>
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-sm text-gray-500 font-medium">Narrative &amp; Score · Working Perspective</span>
          <h3 class="text-xl font-serif font-bold mt-2 mb-2">Designing Proposals for Reviewer Navigation</h3>
          <p class="text-gray-600 text-sm mb-4">A working perspective on making proposal evidence easier to locate, compare, and score within the controlling criteria.</p>
          <a href="/insights/how-reviewers-read" class="text-ridge-blue hover:underline font-medium text-sm">Read more →</a>
        </div>
        <div class="border border-gray-200 rounded-lg p-6 hover:shadow-md transition-shadow">
          <span class="text-sm text-gray-500 font-medium">Budgets &amp; Evidence</span>
          <h3 class="text-xl font-serif font-bold mt-2 mb-2">Budget Trust Signals</h3>
          <p class="text-gray-600 text-sm mb-4">Practical checks for keeping a proposal budget aligned with the narrative, scope, and funder instructions.</p>
          <a href="/insights/budget-trust-signals" class="text-ridge-blue hover:underline font-medium text-sm">Read more →</a>
        </div>
      </div>
      <div class="text-center mt-8">
        <a href="/insights" class="text-ridge-blue hover:underline font-medium">View all insights →</a>
      </div>
    </div>
  </section>

  <!-- CTA Footer -->
  <section class="py-20 bg-slate-deep text-white">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-4xl font-serif font-bold mb-6">Bring a Priority, a Deadline, and a Scope Question</h2>
      <p class="text-xl text-gray-300 mb-8">
        Have an identified funder, draft, or deadline? Start with a defined grant scope and we will confirm fit, inputs, and timing.
      </p>
      <a
        href="/contact?service=grant-writing"
        class="inline-block px-8 py-3 bg-ridge-blue text-white rounded-md text-lg font-medium hover:bg-opacity-90 transition-colors"
      >
        Discuss your grant
      </a>
    </div>
  </section>
</BaseLayout>
