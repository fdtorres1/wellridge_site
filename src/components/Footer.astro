---
const footerNav = [
  { label: 'About', href: '/about' },
  { label: 'Services', href: '/services' },
  { label: 'Grant writing', href: '/grant-writing' },
  { label: 'Resources', href: '/resources' },
  { label: 'Process', href: '/process' },
  { label: 'Pricing', href: '/pricing' },
  { label: 'Insights', href: '/insights' },
  { label: 'Contact', href: '/contact' },
];
---

<footer class="bg-slate-deep text-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <div>
        <h3 class="text-xl font-serif font-bold tracking-[0.14em] mb-2">WELLRIDGE</h3>
        <p class="text-gray-300 text-sm mb-3">Wellridge Group</p>
        <p class="text-gray-300 text-sm">
          Funding &amp; Program Operations for nonprofits and public-sector organizations.
        </p>
      </div>
      <div>
        <h4 class="font-semibold mb-4">Navigation</h4>
        <ul class="space-y-2">
          {footerNav.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-gray-300 hover:text-white text-sm transition-colors"
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h4 class="font-semibold mb-4">Connect</h4>
        <ul class="space-y-2">
          <li>
            <a
              href="/contact"
              class="text-gray-300 hover:text-white text-sm transition-colors"
            >
              Contact
            </a>
          </li>
          <li>
            <a
              href="https://www.wellridgegroup.com"
              class="text-gray-300 hover:text-white text-sm transition-colors"
            >
              www.wellridgegroup.com
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div class="mt-8 pt-8 border-t border-gray-700 text-center text-sm text-gray-400">
      <p>&copy; {new Date().getFullYear()} Wellridge Group. All rights reserved.</p>
    </div>
  </div>
</footer>
